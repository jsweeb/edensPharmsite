# Example environment configuration for Eden’s Pharm App

# Vineyard API
VINEYARD_BASE_URL=
VINEYARD_API_KEY=

# SamCart API
SAMCART_BASE_URL=
SAMCART_API_KEY=

# SamCart webhook secret used to verify webhook signatures
SAMCART_WEBHOOK_SECRET=

# Public URL of the site (used for sitemap, robots.txt and social cards)
NEXT_PUBLIC_SITE_URL=https://edenspharm.com
